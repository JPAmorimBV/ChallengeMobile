{
  "name": "nexus-tech-mottu",
  "version": "1.0.0",
  "description": "Sistema de Gestão Mottu - Challenge FIAP 2025 Sprint 4",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "node scripts/get-commit-hash.js",
    "build": "npm run prebuild && expo build",
    "build:android": "npm run prebuild && eas build --platform android",
    "build:ios": "npm run prebuild && eas build --platform ios",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-picker/picker": "2.4.10",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "expo-notifications": "~0.20.1",
    "expo-device": "~5.4.0",
    "expo-constants": "~14.4.2",
    "expo-localization": "~14.3.0",
    "expo-clipboard": "~4.3.1",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "axios": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.2.1",
    "prettier": "^3.0.3",
    "typescript": "^5.1.3"
  },
  "keywords": [
    "react-native",
    "typescript",
    "expo",
    "mottu",
    "nexus-tech",
    "fiap",
    "challenge",
    "mobile"
  ],
  "author": "Nexus Tech",
  "license": "MIT",
  "private": true
}
