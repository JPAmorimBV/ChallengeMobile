{
  "expo": {
    "name": "Nexus Tech Mottu",
    "slug": "nexus-tech-mottu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2196F3"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2196F3"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexustech.mottu",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2196F3"
      },
      "package": "com.nexustech.mottu",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "commitHash": "obter-via-script",
      "eas": {
        "projectId": "seu-project-id-aqui"
      }
    }
  }
}
